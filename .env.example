# nanohome environment variables.
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored — never commit secrets. Required vars with no value below will
# cause `next build` / `next dev` to fail at the zod parse in
# `src/lib/env.ts` until they are set.

# ---------------------------------------------------------------------------
# PUBLIC — safe to expose to the browser (prefixed NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_PROJECT_REF=your-project
# Public catalog/media origin. Required by staging catalog readiness.
NEXT_PUBLIC_MEDIA_URL=https://media.example.invalid

# Optional: Microsoft Clarity analytics session id.
# NEXT_PUBLIC_CLARITY_ID=
# Meta Pixel used for page views and conversion events.
# NEXT_PUBLIC_META_PIXEL_ID=484179830726882
# Zalo Official Account widget ID.
# NEXT_PUBLIC_ZALO_OA_ID=3326148659494014741

# Percy visual testing. Keep this secret and provide it in your shell/CI only.
# PERCY_TOKEN=

# Optional: Axiom Next.js logging/telemetry.
# NEXT_PUBLIC_AXIOM_DATASET=
# NEXT_PUBLIC_AXIOM_TOKEN=

# Optional: Fillout checkout form for cart submission.
# Current cart form URL: https://forms.fillout.com/t/8H6jTR29nGus
# NEXT_PUBLIC_FILLOUT_CART_FORM_ID=8H6jTR29nGus

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefixed, never imported by client components.
# ---------------------------------------------------------------------------
# Supabase service role key. Bypasses RLS. Only import via
# src/lib/supabase/admin.ts (which has `import "server-only"`).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Shared secret protecting cron/route handler endpoints.
CRON_SECRET=your_cron_secret_here
# Dedicated CSRF secret, at least 32 bytes. Never reuse another provider key.
AUTH_CSRF_SECRET=replace_with_a_dedicated_random_secret_at_least_32_bytes

# ---------------------------------------------------------------------------
# PROVIDERS — disabled by default; active modes require their complete block
# ---------------------------------------------------------------------------
AUTH_PROVIDER=supabase
PAYMENT_MODE=off # off | sepay_sandbox | sepay_primary
CHAT_ENABLED=false
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PROMPT_VERSION=public-advisor-v3
CHAT_HANDOFF_ENABLED=false
ADVISOR_INBOX_ENABLED=false
ADVISOR_NOTIFICATION_PROVIDER=noop # noop | fake | off | webhook
# ADVISOR_NOTIFICATION_DESTINATION=
# ADVISOR_NOTIFICATION_API_KEY=

VISION_PROVIDER=off # off | fake | noop | primary
# VISION_MODEL=
# VISION_API_KEY=
# VISION_PRIVATE_BUCKET=
VISION_UPLOAD_ENABLED=false
ROOM_ANALYSIS_ENABLED=false
VISUAL_SIMILARITY_ENABLED=false
# VISION_RETENTION_DAYS=
VISION_EVALUATION_STORAGE_ENABLED=false

# SePay is server-only. Never create NEXT_PUBLIC_SEPAY_* variables.
# SEPAY_ENV=sandbox
# SEPAY_API_BASE_URL=https://userapi-sandbox.sepay.vn/v2
# SEPAY_API_TOKEN=
# SEPAY_WEBHOOK_HMAC_SECRET=
# Test Mode bank account UUID returned by the sandbox API (not an account number).
# SEPAY_TEST_BANK_ACCOUNT_ID=
# Payment Gateway primary-mode values; not used by Test Mode VietQR.
# SEPAY_MERCHANT_ID=
# SEPAY_MERCHANT_SECRET=
# SEPAY_IPN_SECRET=
# SEPAY_PAYMENT_METHOD=BANK_TRANSFER
# SEPAY_SUCCESS_URL=https://app.example.invalid/payment/success
# SEPAY_ERROR_URL=https://app.example.invalid/payment/error
# SEPAY_CANCEL_URL=https://app.example.invalid/payment/cancel
SEPAY_RECONCILIATION_ENABLED=false

# Firebase: ADC uses FIREBASE_ADMIN_PROJECT_ID only. Explicit credentials use
# the same project ID plus both client email and private key. Never mix modes.
# NEXT_PUBLIC_APP_ORIGIN=https://app.example.invalid
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-id
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_TENANT_ID=
ACCOUNT_CENTER_ENABLED=false
# FIREBASE_ADMIN_PROJECT_ID=project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/firebase-admin.json
# AUTH_SESSION_TTL_SECONDS=1209600
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# KAKAO_APP_ID=
# KAKAO_ADMIN_KEY=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# Never create NEXT_PUBLIC_KAKAO_* variables.

# Test-runner aliases are injected securely for staging UI runs. They are not
# application credentials and their values must not be committed or pasted.
# AUTH_EMAIL_VERIFIED=
# AUTH_PHONE_TEST=
# AUTH_GOOGLE_TEST=

# Optional R2 write credentials for controlled catalog/media import or sync.
# Remove them from the long-running web runtime when no server upload path is used.
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# CF_R2_BUCKET=

# Optional: server-side direct Fillout submit, only needed if the cart UI later
# collects customer contact fields before submission.
# FILLOUT_API_KEY=
# FILLOUT_CART_FORM_ID=8H6jTR29nGus
# FILLOUT_CART_QUESTION_NAME_ID=rP8z
# FILLOUT_CART_QUESTION_PHONE_ID=j5ou
# FILLOUT_CART_QUESTION_EMAIL_ID=b4Qk
# FILLOUT_CART_QUESTION_ITEMS_ID=nNHy
# FILLOUT_CART_QUESTION_TOTAL_ID=sipw
# FILLOUT_CART_PARAM_SOURCE_ID=source
# FILLOUT_CART_PARAM_PAGE_URL_ID=page_url

# Instagram Graph API for the managed nanohome_gallery Professional account.
# Create a long-lived token in Meta, then keep both values server-only.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# AMIS — server-only third-party ERP integration (all optional until wired)
# ---------------------------------------------------------------------------
# AMIS CRM Connect v2. The app exchanges these credentials for a short-lived
# Bearer token, then makes GET-only business-data requests.
# AMIS_API_BASE_URL=https://crmconnect.misa.vn
# AMIS_CLIENT_ID=
# AMIS_CLIENT_SECRET=
AMIS_SYNC_ENABLED=false
AMIS_WRITES_ENABLED=false
AMIS_PERSONALIZATION_ENABLED=false
AMIS_CUSTOMER_PILOT_ENABLED=false
# AMIS_CUSTOMER_PILOT_AUDIT_PATH=/absolute/path/outside/project/pilot.json
# AMIS_CUSTOMER_PILOT_HMAC_SECRET=
RECOMMENDATIONS_SHADOW_MODE=true

# ---------------------------------------------------------------------------
# INSTAGRAM GRAPH API — server-only
# ---------------------------------------------------------------------------
# Long-lived user token and the connected Professional account ID.
# The cron refreshes the token before it expires and caches the latest media.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_APP_ID=
# META_APP_SECRET=

# ---------------------------------------------------------------------------
# ANALYTICS — optional, public (see PUBLIC block above)
# ---------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
WISTIA_API_TOKEN=your_wistia_api_token_here

# Password-protected, unindexed CA performance report.
CA_PERFORMANCE_PASSWORD=nanoCAp3rf
CA_PERFORMANCE_AUTH_TOKEN=nanoCAp3rf
CA_PERFORMANCE_EMBED_URL=https://app.fabric.microsoft.com/view?r=your_publish_to_web_token
